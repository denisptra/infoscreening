APP_NAME="Infoscreening"
APP_ENV=production
# Generate di lokal sebelum upload dengan: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://next.infoscreening.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_infoscreening
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=next.infoscreening.id
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Konfigurasi SMTP cPanel (Email Accounts -> noreply@infoscreening.id)
# Jangan gunakan MAIL_ENCRYPTION di Laravel 11+; gunakan MAIL_SCHEME=smtps untuk port 465.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.infoscreening.id
MAIL_PORT=465
MAIL_USERNAME=noreply@infoscreening.id
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@infoscreening.id"
MAIL_FROM_NAME="Infoscreening"

VITE_APP_NAME="${APP_NAME}"
